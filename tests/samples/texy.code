<?php

namespace App;

use Texy\Bridges\Latte\TexyMacro;
use Texy\HandlerInvocation;
use Texy\Helpers;
use Texy\HtmlElement;
use Texy\Image;
use Texy\Modifier;
use Texy\Modules\LongWordsModule;
use Texy\Strict;
use Texy\Texy;
use Texy\Utf;


class TexyFactory
{
	public function create(HandlerInvocation $invocation, \Texy\Link $link, string $s): Texy
	{
		$texy = new Texy;
		$texy->setOutputMode(Texy::XHTML1_STRICT);
		$mode = $texy->getOutputMode();
		$texy->encoding = 'windows-1250';
		$texy->styleSheet = 'p {}';
		$texy->xhtml = false;
		Texy::$strictDTD = true;
		Texy::$advertisingNotice = false;
		$texy->cleaner->indent = true;
		$texy->htmlOutputModule->removeOptional = true;
		$texy->linkModule->popupOnClick = '';
		$texy->linkModule->imageOnClick = '';
		$texy->imageModule->onLoad = '';
		$texy->scriptModule->handler = $this;
		$texy->dtd['p'][1]['div'] = 1;
		$classes = $texy->_classes;
		$styles = $texy->_styles;
		HtmlElement::$xhtml = false;
		$revision = Texy::REVISION;
		$texy->linkModule->solveUrlEmail($invocation, $link);
		$texy->htmlOutputModule->postProcess($texy, $s);
		$cite = $texy->blockQuoteModule->citeLink('https://texy.info');
		$html = $texy->process('text');
		$texy->free();
		$texy->figureModule->requireCaption = false;
		$texy->figureModule->widthDelta = 20;
		$texy->imageModule->defaultAlt = 'image';
		$texy->imageModule->linkedRoot = '/images/';
		$texy->linkModule->imageClass = 'image';
		$texy->emoticonModule->class = 'smiley';
		$texy->emoticonModule->root = '/smileys/';
		$texy->emoticonModule->fileRoot = '/var/www/smileys/';
		$texy->tableModule->oddClass = 'odd';
		$texy->tableModule->evenClass = 'even';
		$strict = Texy::HTML4_STRICT;
		$all = TEXY_ALL;
		$modifier = \TEXY_MODIFIER;
		return $texy;
	}


	public function helpers(Texy $texy, string $s): array
	{
		return [
			Texy::webalize($s),
			Texy::webalize($s, null),
			Helpers::webalize($s, null),
			Texy::freezeSpaces($s),
			Texy::unfreezeSpaces($s),
			Texy::normalize($s),
			Texy::outdent($s),
			Texy::isRelative($s),
			Texy::prependRoot($s, '/'),
			Texy::escapeHtml($s),
			Texy::unescapeHtml($s),
			$texy->blockModule->outdent($s),
			Utf::strtolower($s),
			Utf::utf2ascii($s),
			Utf::toUtf($s, 'cp1250'),
			Utf::utfTo($s, 'cp1250'),
			Utf::utf2html($s, 'cp1250'),
		];
	}


	public function elements(Modifier $modifier, Image $image, HandlerInvocation $invocation): void
	{
		$el = new \TexyHtml('p');
		$text = HtmlElement::INNER_TEXT;
		$transparent = HtmlElement::INNER_TRANSPARENT;
		$mod = new Modifier(mod: '.class');
		$modifier->setProperties(mod: '.class');
		$cite = $modifier->cite;
		$image->overURL = 'over.gif';
		$invocation->free();
		$limit = LongWordsModule::SAFE_LIMIT;
		$dont = LongWordsModule::DONT;
		$html5 = Texy::HTML5;
		$link = new \TexyLink('https://texy.info');
		$config = \TexyConfigurator::class;
	}


	public function latte(\Latte\Engine $latte, Texy $texy): void
	{
		new TexyMacro($latte, $texy);
	}
}


class MyTexy extends Texy
{
	public function __construct()
	{
		parent::__construct();
		$this->setOutputMode(self::HTML5);
		$this->cleaner->indent = false;
		$this->encoding = 'utf-8';
		self::webalize('x');
		$this->htmlOutputModule->removeOptional = true;
		$xml = self::XML;
	}


	public function lower(Utf $utf, string $s): string
	{
		return $utf instanceof Utf ? Utf::strtolower($s) : $s;
	}


	public function free(): void
	{
	}
}


class TexyThree
{
	public function configure(Texy $texy, string $s): string
	{
		$old = new \Texy;
		$html = $texy->process($s);
		$line = $texy->process($s, true);
		$full = $texy->process($s, false);
		$line = $texy->processLine($s);
		$typo = $texy->processTypo($s);
		$text = $texy->toText();
		$texy->allowed['phrase/em'] = false;
		$texy->allowedTags = Texy::ALL;
		$tags = $texy->allowedTags;
		$texy->allowedClasses = Texy::NONE;
		$texy->allowedStyles = ['color'];
		$texy->obfuscateEmail = false;
		$texy->mergeLines = false;
		$texy->tabWidth = 4;
		$texy->removeSoftHyphens = false;
		$texy->alignClasses['left'] = 'left';
		$texy->urlSchemeFilters[Texy::FILTER_ANCHOR] = '#https?:#A';
		$texy->nontextParagraph = 'div';
		$summary = $texy->summary;
		$texy->registerLinePattern(fn() => null, '#x#', 'my');
		$texy->registerBlockPattern(fn() => null, '#x#m', 'myBlock');
		$texy->registerPostLine(fn($s) => $s, 'post');
		$texy->addHandler('image', fn() => null);
		$ok = $texy->checkURL($s, 'a');
		$dom = $texy->getDOM($s);
		$mark = $texy->protect($s, Texy::CONTENT_MARKUP);
		$texy->imageModule->root = '/images/';
		$texy->imageModule->leftClass = 'left';
		$texy->figureModule->tagName = 'figure';
		$texy->linkModule->root = '/';
		$texy->linkModule->addReference('home', '/');
		$texy->headingModule->top = 2;
		$texy->headingModule->balancing = \Texy\Modules\HeadingModule::FIXED;
		$toc = $texy->headingModule->TOC;
		$texy->phraseModule->tags['phrase/em'] = 'i';
		$texy->typographyModule->locale = 'en';
		$texy->longWordsModule->wordLimit = 30;
		$texy->htmlOutputModule->lineWrap = 100;
		$texy->htmlModule->passComment = false;
		$texy->emoticonModule->icons[':-)'] = '🙂';
		$texy->imageModule->solve(null, new \Texy\Image, true);
		return $texy::VERSION . $html . $line . $full . $typo . $text;
	}


	public function helpers(string $s): array
	{
		return [
			\Texy\Patterns::MODIFIER,
			\Texy\Patterns::LINK_URL,
			\Texy\Helpers::normalize($s),
			\Texy\Configurator::$safeTags,
			\Texy\Modifier::$elAttrs,
			\Texy\Regexp::match($s, '#x#', \Texy\Regexp::OFFSET_CAPTURE),
			new \Texy\Modifier(mod: '.class'),
			new \Texy\Modifier(s: '#id'),
		];
	}
}


class MyModule extends \Texy\Module
{
	public function init(): void
	{
		$this->texy->allowed['my'] = true;
	}
}


class Article
{
	use Strict;

	public string $text = '';
}
