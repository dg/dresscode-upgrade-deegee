package: texy/texy

since 4.0:
	replacedClasses:
		Texy: Texy\Texy
		TexyHtml: keep
		TexyImage: keep
		TexyLink: keep
		TexyLinkModule: keep
		TexyLongWordsModule: keep
		TexyTypographyModule: keep
	replacedMembers:
		Texy\Texy::VERSION: Version
		Texy\Texy::$allowed: $allowedSyntax
		Texy\Texy::$cleaner: keep
		Texy\Texy::processLine: toInlineHtml
		Texy\Texy::processTypo: applyTypography
		Texy\Texy::normalize: keep
		Texy\Texy::unProtect: keep
		Texy\Patterns::CHAR: Letter
		Texy\Patterns::LINK_URL: LinkUrl
		Texy\Patterns::MODIFIER: Modifier
		Texy\Patterns::MODIFIER_H: ModifierHAlign
		Texy\Patterns::MODIFIER_HV: ModifierHVAlign
		Texy\HtmlElement::INNER_TEXT: keep
		Texy\HtmlElement::INNER_TRANSPARENT: keep
	replacedCalls:
		'Texy\Texy::process($text)': 'toHtml($text)'
		'Texy\Texy::process($text, false)': 'toHtml($text)'
		'Texy\Texy::process($text, true)': 'toInlineHtml($text)'
		'Texy\Texy::$allowedTags::get': '$this->htmlPolicy->allowedTags'
		'Texy\Texy::$allowedTags::set': '$this->htmlPolicy->allowedTags = $value'
		'Texy\Texy::$allowedClasses::get': '$this->htmlPolicy->allowedClasses'
		'Texy\Texy::$allowedClasses::set': '$this->htmlPolicy->allowedClasses = $value'
		'Texy\Texy::$allowedStyles::get': '$this->htmlPolicy->allowedStyles'
		'Texy\Texy::$allowedStyles::set': '$this->htmlPolicy->allowedStyles = $value'
		'Texy\Texy::$obfuscateEmail::get': '$this->htmlOutput->obfuscateEmail'
		'Texy\Texy::$obfuscateEmail::set': '$this->htmlOutput->obfuscateEmail = $value'
		'Texy\Texy::$mergeLines::get': '$this->config->mergeLines'
		'Texy\Texy::$mergeLines::set': '$this->config->mergeLines = $value'
		'Texy\Modifier::__construct(mod: $m, ...)': keep
		'Texy\Modifier::__construct(mod: $m)': {write: '\Texy\Modifier::parse($m)', because: '`parse()` returns `null` for an empty modifier'}
		'Texy\Modifier::__construct(s: $m)': {write: '\Texy\Modifier::parse($m)', because: '`parse()` returns `null` for an empty modifier'}
		'Texy\Modifier::setProperties(mod: $m)': keep
	forbiddenClasses:
		Texy\HandlerInvocation: 'the event system is gone; register a pass with `Texy\Texy::addPass()` or a renderer with `Texy\Output\Html\Config::addRenderer()`'
		Texy\Parser: 'a syntax handler receives a `Texy\Parsing\ParseContext`'
		Texy\BlockParser: 'a syntax handler receives a `Texy\Parsing\ParseContext`'
		Texy\LineParser: 'a syntax handler receives a `Texy\Parsing\ParseContext`'
		Texy\HtmlElement: 'create a `Texy\Output\Html\Element` in a renderer, whose constructor takes attributes only'
		TexyHtml: 'create a `Texy\Output\Html\Element` in a renderer, whose constructor takes attributes only'
		Texy\Image: 'an image is a `Texy\Nodes\ImageNode` of the document tree'
		TexyImage: 'an image is a `Texy\Nodes\ImageNode` of the document tree'
		Texy\Link: 'a link is a `Texy\Nodes\LinkNode` of the document tree'
		TexyLink: 'a link is a `Texy\Nodes\LinkNode` of the document tree'
		Texy\Modules\TableCellElement: 'a table cell is a `Texy\Nodes\TableCellNode` of the document tree'
		Texy\Modules\BlockModule: 'there is no replacement; modules are internal; handle custom `/--` blocks by `Texy\Config::$delimitedBlockHandler`'
		Texy\Modules\FigureModule: 'there is no replacement; modules are internal'
		Texy\Modules\HorizLineModule: 'there is no replacement; modules are internal'
		Texy\Modules\LinkModule: 'there is no replacement; modules are internal'
		TexyLinkModule: 'there is no replacement; modules are internal'
		Texy\Modules\LongWordsModule: 'there is no replacement; hyphenation is switched by `Texy\Config::$hyphenation`'
		TexyLongWordsModule: 'there is no replacement; hyphenation is switched by `Texy\Config::$hyphenation`'
		Texy\Modules\TypographyModule: 'there is no replacement; typography is switched by `Texy\Config::$typography`'
		TexyTypographyModule: 'there is no replacement; typography is switched by `Texy\Config::$typography`'
		Texy\Modules\ScriptModule: 'handle the directives `{{name: ...}}` by `Texy\Config::$directiveHandler`'
		Texy\Modules\HtmlOutputModule: 'use `Texy\Output\Html\Config`, reached as `$texy->htmlOutput`'
	forbiddenMembers:
		'Texy\Texy::process($text, $singleLine)': 'call `toHtml()`, or `toInlineHtml()` for a single line'
		'Texy\Texy::toText()': 'pass the Texy source, or render a parsed document with `renderText()`'
		Texy\Texy::ALL: 'use `true`'
		Texy\Texy::NONE: 'use `false`'
		Texy\Texy::loadModules: 'there is no replacement; modules are internal'
		Texy\Texy::addHandler: 'the event system is gone; register a pass with `addPass()` or a renderer with `Texy\Output\Html\Config::addRenderer()`'
		Texy\Texy::invokeHandlers: 'the event system is gone; register a pass with `addPass()` or a renderer with `Texy\Output\Html\Config::addRenderer()`'
		Texy\Texy::invokeAroundHandlers: 'the event system is gone; register a pass with `addPass()` or a renderer with `Texy\Output\Html\Config::addRenderer()`'
		Texy\Texy::registerLinePattern: 'call `addInlineSyntax($name, $pattern, $parser)`, whose parser gets a `Texy\Parsing\ParseContext` and returns a node'
		Texy\Texy::registerBlockPattern: 'call `addBlockSyntax($name, $pattern, $parser)`, whose parser gets a `Texy\Parsing\ParseContext` and returns a node'
		Texy\Texy::registerPostLine: 'register a pass over the document with `addPass()`'
		Texy\Texy::getLinePatterns: 'there is no replacement'
		Texy\Texy::getBlockPatterns: 'there is no replacement'
		Texy\Texy::protect: 'return a `Texy\Output\Html\Element` or `Texy\Output\Html\Raw` from a renderer'
		Texy\Texy::unprotect: 'return a `Texy\Output\Html\Element` or `Texy\Output\Html\Raw` from a renderer'
		Texy\Texy::unProtect: 'return a `Texy\Output\Html\Element` or `Texy\Output\Html\Raw` from a renderer'
		Texy\Texy::stringToHtml: 'call `toHtml()` with the Texy source'
		Texy\Texy::stringToText: 'call `toText()` with the Texy source'
		Texy\Texy::checkURL: 'call `$texy->urlPolicy->isLinkAllowed()` or `isImageAllowed()`'
		Texy\Texy::getDOM: 'call `parse()`, which returns the document tree'
		Texy\Texy::CONTENT_BLOCK: 'there is no replacement; the protection marks are gone'
		Texy\Texy::CONTENT_MARKUP: 'there is no replacement; the protection marks are gone'
		Texy\Texy::CONTENT_REPLACED: 'there is no replacement; the protection marks are gone'
		Texy\Texy::CONTENT_TEXTUAL: 'there is no replacement; the protection marks are gone'
		Texy\Texy::FILTER_ANCHOR: 'use `$texy->urlPolicy->linkPattern`'
		Texy\Texy::FILTER_IMAGE: 'use `$texy->urlPolicy->imagePattern`'
		Texy\Texy::$urlSchemeFilters: 'use `$texy->urlPolicy->linkPattern` and `imagePattern`, where `null` allows every scheme'
		Texy\Texy::$alignClasses: 'use `$texy->htmlOutput->textAlignClasses` and `verticalAlignClasses`'
		Texy\Texy::$nontextParagraph: 'use `$texy->htmlOutput->imageParagraphTag`, which holds a tag name only'
		Texy\Texy::$cleaner: 'use `$texy->htmlOutput`, which holds the settings of HTML output'
		Texy\Texy::$summary: 'read the links and images from the document returned by `parse()`'
		Texy\Texy::$tabWidth: 'there is no replacement; a tab is one whitespace character; drop the setting'
		Texy\Texy::$removeSoftHyphens: 'there is no replacement; literal soft hyphens are always removed and `&shy;` keeps one; drop the setting'
		Texy\Texy::$_classes: 'the property is private; the allowed classes are configured by `$texy->htmlPolicy->allowedClasses`'
		Texy\Texy::$_styles: 'the property is private; the allowed styles are configured by `$texy->htmlPolicy->allowedStyles`'
		Texy\Module::$texy: 'there is no replacement; custom modules are not supported'
		Texy\Patterns::IMAGE: 'there is no replacement'
		Texy\Patterns::MARK: 'there is no replacement; the protection marks are gone'
		Texy\Modifier::decorate: 'there is no replacement; the HTML renderer applies the modifier to the element'
		Texy\Modifier::setProperties: 'create the modifier with `parse()`'
		Texy\Modifier::$elAttrs: 'read the constant `ElAttrs`, which can no longer be changed'
		Texy\Configurator::$safeTags: 'read the constant `SafeTags`, which can no longer be changed'
		Texy\Helpers::normalize: 'call `Texy\Texy::normalize()`, which also removes the BOM and literal soft hyphens'
		Texy\Regexp::ALL: 'call `matchAll()`'
		Texy\Regexp::OFFSET_CAPTURE: 'pass `captureOffset: true`'
		Texy\Modules\HeadingModule::DYNAMIC: 'use the case `Texy\HeadingBalancing::Dynamic` in `$texy->config->headingBalancing`'
		Texy\Modules\HeadingModule::FIXED: 'use the case `Texy\HeadingBalancing::Fixed` in `$texy->config->headingBalancing`'
		Texy\Modules\HtmlModule::$passComment: 'use `$texy->htmlOutput->passHtmlComments`'
		Texy\Modules\ImageModule::$root: 'use `$texy->htmlOutput->imageBaseUrl`'
		Texy\Modules\ImageModule::$fileRoot: 'use `$texy->htmlOutput->imageBasePath`'
		Texy\Modules\ImageModule::$leftClass: 'use `$texy->htmlOutput->floatClasses[''left'']`, one class for images and figures'
		Texy\Modules\ImageModule::$rightClass: 'use `$texy->htmlOutput->floatClasses[''right'']`, one class for images and figures'
		Texy\Modules\ImageModule::addReference: 'there is no replacement; define the image in the document, or set its URL in a pass over `Texy\Nodes\ImageNode`'
		Texy\Modules\FigureModule::$leftClass: 'use `$texy->htmlOutput->floatClasses[''left'']`, one class for images and figures'
		Texy\Modules\FigureModule::$rightClass: 'use `$texy->htmlOutput->floatClasses[''right'']`, one class for images and figures'
		Texy\Modules\FigureModule::$tagName: 'use `$texy->htmlOutput->figureTag`'
		Texy\Modules\FigureModule::$class: 'use `$texy->htmlOutput->figureClass`'
		Texy\Modules\LinkModule::$root: 'use `$texy->htmlOutput->linkBaseUrl`'
		Texy\Modules\LinkModule::$forceNoFollow: 'use `$texy->htmlOutput->linkNoFollow`'
		Texy\Modules\LinkModule::$shorten: 'use `$texy->htmlOutput->shortenUrls`'
		Texy\Modules\LinkModule::addReference: 'use `$texy->config->linkResolver`, a closure that gets the name and the `Texy\Nodes\LinkNode` and returns the URL'
		Texy\Modules\PhraseModule::$tags: 'use `$texy->htmlOutput->phraseTags`, whose keys say what a phrase means, such as `emphasis`, instead of the syntax'
		Texy\Modules\PhraseModule::$linksAllowed: 'use `$texy->allowedSyntax[''phrase/link'']`'
		Texy\Modules\EmoticonModule::$icons: 'use `$texy->config->emoticons`'
		Texy\Modules\EmoticonModule::$class: 'use `$texy->htmlOutput->emoticonClass`'
		Texy\Modules\HeadingModule::$top: 'use `$texy->config->headingTop`'
		Texy\Modules\HeadingModule::$generateID: 'use `$texy->config->headingIds`'
		Texy\Modules\HeadingModule::$idPrefix: 'use `$texy->config->headingIdPrefix`'
		Texy\Modules\HeadingModule::$moreMeansHigher: 'use `$texy->config->headingMoreMeansHigher`'
		Texy\Modules\HeadingModule::$balancing: 'use `$texy->config->headingBalancing`, which holds a case of `Texy\HeadingBalancing`'
		Texy\Modules\HeadingModule::$title: 'read the headings from the document returned by `Texy\Texy::parse()` as `Texy\Nodes\HeadingNode`'
		Texy\Modules\HeadingModule::$TOC: 'read the headings from the document returned by `Texy\Texy::parse()` as `Texy\Nodes\HeadingNode`'
		Texy\Modules\HeadingModule::$levels: 'there is no replacement; the levels of the underline characters are fixed'
		Texy\Modules\HorizLineModule::$classes: 'use `$texy->htmlOutput->horizontalRuleClasses`'
		Texy\Modules\ListModule::$bullets: 'there is no replacement; the bullets are fixed and the kinds of numbering are switched in `$texy->allowedSyntax`'
		Texy\Modules\TypographyModule::$locale: 'use `$texy->config->locale`'
		Texy\Modules\TypographyModule::$locales: 'use `$texy->config->locales`, whose rows hold four quotes under the key `quotes`'
		Texy\Modules\LongWordsModule::$wordLimit: 'use `$texy->config->hyphenationWordLimit`'
		Texy\Modules\HtmlOutputModule::$indent: 'use `$texy->htmlOutput->indent`'
		Texy\Modules\HtmlOutputModule::$preserveSpaces: 'use `$texy->htmlOutput->preserveSpaces`'
		Texy\Modules\HtmlOutputModule::$baseIndent: 'use `$texy->htmlOutput->baseIndent`'
		Texy\Modules\HtmlOutputModule::$lineWrap: 'use `$texy->htmlOutput->lineWrap`'
		Texy\Modules\ScriptModule::$separator: 'there is no replacement; the arguments of a directive are read by `$texy->config->directiveHandler`'
		Texy\Modules\ScriptModule::$handler: 'use `$texy->config->directiveHandler`'
		Texy\Modules\ImageModule::solve: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\ImageModule::getReference: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\ImageModule::factoryImage: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\LinkModule::solve: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\LinkModule::getReference: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\LinkModule::factoryLink: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
		Texy\Modules\ParagraphModule::process: 'work with the nodes in a pass registered by `Texy\Texy::addPass()` or a renderer registered by `Texy\Output\Html\Config::addRenderer()`'
