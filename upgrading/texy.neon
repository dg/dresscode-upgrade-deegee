since 3.2.8:
	replacedMembers:
		Texy\Texy::unProtect: unprotect
	forbiddenMembers:
		Texy\Modules\FigureModule::$requireCaption: 'there is no replacement'
		Texy\Modules\FigureModule::$widthDelta: 'size the figure with CSS'
		Texy\Modules\ImageModule::$defaultAlt: 'there is no replacement'
		Texy\Modules\ImageModule::$linkedRoot: 'there is no replacement'
		Texy\Modules\LinkModule::$imageClass: 'there is no replacement'
		Texy\Modules\EmoticonModule::$class: keep

since 3.2.6:
	forbiddenClasses:
		Texy\Bridges\Latte\TexyMacro: 'support for Latte 2 is gone; register `new Texy\Bridges\Latte\TexyExtension($texy)` with `Latte\Engine::addExtension()`'

since 3.2:
	forbiddenClasses:
		Texy\Strict: 'there is no replacement; the trait is gone; undefined members follow plain PHP semantics'
	forbiddenMembers:
		Texy\Modifier::$cite: 'there is no replacement; support for the `cite` attribute is gone'
		Texy\Modules\BlockQuoteModule::citeLink: 'there is no replacement; support for the `cite` attribute is gone'
